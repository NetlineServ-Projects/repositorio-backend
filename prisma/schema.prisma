generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senha        String
  numero       String   @default("")
  cargo        String   @default("")
  departamento String   @default("")
  perfil       Perfil   @default(FUNCIONARIO)
  ativo        Boolean  @default(true)
  fotografia   String? 
  dataCriacao  DateTime @default(now())

  temaEscuro        Boolean @default(false)
  notificacoesEmail Boolean @default(true)
  idioma            String  @default("pt")

  documentos Documento[]
  atividades Atividade[]
}

model Documento {
  id             Int             @id @default(autoincrement())
  titulo         String
  descricao      String?
  nomeArquivo    String
  caminho        String 
  tipoArquivo    String
  tamanho        BigInt
  estado         EstadoDocumento @default(PENDENTE)
  dataSubmissao  DateTime        @default(now())
  motivoRejeicao String?
  apagadoEm      DateTime?

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

 
  sistemaId Int?
  sistema   Sistema? @relation(fields: [sistemaId], references: [id], onDelete: SetNull)

  atividades Atividade[]
}

model Categoria {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String?
  sensivel  Boolean @default(false)

  documentos Documento[]
}

model Sistema {
  id                        Int           @id @default(autoincrement())
  nome                      String        @db.VarChar(255)
  desenvolvedores           Json
  empresasClientes          Json
  descricaoCurta            String?       @db.VarChar(255)
  descricaoLonga            String?       @db.Text
  dataInicio                DateTime
  dataEntrega               DateTime?
  status                    StatusSistema @default(EM_DESENVOLVIMENTO)
  tecnologiasFrontend       Json?
  tecnologiasBackend        Json?
  tecnologiasInfraestrutura Json?
  repositorioUrl            String?       @db.VarChar(255)
  urlProducao               String?       @db.VarChar(255)
  responsavelTecnico        String?       @db.VarChar(255)
  versaoAtual               String?       @db.VarChar(50)
  ativo                     Boolean       @default(true)
  documentos                Documento[]
  atividades                Atividade[]
  dataCriacao               DateTime      @default(now())


  infraestruturas SistemaInfraestrutura[]

  @@map("sistemas")
}
    
model Plataforma {
  id         Int            @id @default(autoincrement())
  nome       String         @unique @db.VarChar(255)
  tipo       TipoPlataforma
  fornecedor FornecedorPlataforma
  logotipo   String?        @db.VarChar(255) 
  urlPainel  String?        @db.VarChar(255)
  ativo      Boolean        @default(true)

  utilizador     String?
  tokenCifrado   String? @db.Text // AES-256-GCM

  // Só para CONTAINERIZACAO
  registryUrl String? @db.Text
  namespace   String?
  imagens     ImagemContainer[]

  dominios        Dominio[]
  servidores      Servidor[]
  // Sistemas ligados diretamente à plataforma, sem servidor (ex: Vercel)
  infraestruturas SistemaInfraestrutura[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("plataformas")
}

model Dominio {
  id            Int      @id @default(autoincrement())
  nome          String   @unique @db.VarChar(255) // ex: empresa.co.mz
  dataExpiracao DateTime

  plataformaId Int
  plataforma   Plataforma @relation(fields: [plataformaId], references: [id], onDelete: Restrict)
  subdominios Subdominio[]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([plataformaId])
  @@map("dominios")
}

// A / AAAA → servidorId preenchido | CNAME → destino preenchido (validado na API)
model Subdominio {
  id      Int     @id @default(autoincrement())
  nome    String  @db.VarChar(255) // só o prefixo, ex: "app"
  tipoDns TipoDns @default(A)
  destino String? @db.Text

  dominioId Int
  dominio   Dominio @relation(fields: [dominioId], references: [id], onDelete: Restrict)

  servidorId Int?
  servidor   Servidor? @relation(fields: [servidorId], references: [id], onDelete: SetNull)

  sistemaInfraestruturaId Int                   @unique
  sistemaInfraestrutura   SistemaInfraestrutura @relation(fields: [sistemaInfraestruturaId], references: [id], onDelete: Cascade)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  
  @@unique([dominioId, nome, tipoDns])
  @@index([dominioId])
  @@index([servidorId])
  @@map("subdominios")
}


model Servidor {
  id                  Int                  @id @default(autoincrement())
  nome                String               @db.VarChar(255)
  hostname            String               @db.VarChar(255)
  ipCifrado           String               @db.Text // AES-256-GCM
  ipHash              String               @db.VarChar(64) // HMAC-SHA256, só para unicidade
  usernameSsh         String               @db.VarChar(255)
  passwordCifrada     String               @db.Text // AES-256-GCM; nunca devolvida na árvore
  numeroCpu           Int
  memoriaRam          Int
  memoriaRamUnidade   UnidadeArmazenamento @default(GB)
  disco               Int
  discoUnidade        UnidadeArmazenamento @default(GB)
  larguraBanda        Int
  larguraBandaUnidade UnidadeVelocidade    @default(MBPS)
  sistemaOperativo    String               @db.VarChar(100)
  versaoSo            String?              @db.VarChar(50)
  cloud               String?              @db.VarChar(255)
  regiao              String?              @db.VarChar(100)
  estado EstadoServidor @default(INATIVO)

  plataformaId Int
  plataforma   Plataforma @relation(fields: [plataformaId], references: [id], onDelete: Restrict)

  subdominios     Subdominio[]
  infraestruturas SistemaInfraestrutura[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([plataformaId, ipHash])
  @@index([plataformaId])
  @@map("servidores")
}

model ImagemContainer {
  id           Int                @id @default(autoincrement())
  nome         String
  tag          String             @default("latest")
  portaExposta Int?
  digest       String?
  ultimoPushEm DateTime?
  visibilidade VisibilidadeImagem @default(PRIVADA)
  origem       OrigemImagem       @default(PROPRIA)
  ativo        Boolean            @default(true)
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @updatedAt

  plataformaId Int
  plataforma   Plataforma         @relation(fields: [plataformaId], references: [id], onDelete: Cascade)

  @@unique([plataformaId, nome, tag])
}

model SistemaInfraestrutura {
  id        Int     @id @default(autoincrement())
  sistemaId Int
  sistema   Sistema @relation(fields: [sistemaId], references: [id], onDelete: Cascade)

  ambiente TipoAmbiente @default(PRODUCAO)
  componente ComponenteSistema @default(BACKEND)

  
  servidorId   Int?
  servidor     Servidor?   @relation(fields: [servidorId], references: [id], onDelete: SetNull)
  plataformaId Int?
  plataforma   Plataforma? @relation(fields: [plataformaId], references: [id], onDelete: SetNull)

  url String? @db.VarChar(255) // endereço do sistema neste ambiente

  ipServidor    String? @db.Text // valor encriptado (AES-256-GCM)
  cloudProvedor String? @db.Text // valor encriptado (AES-256-GCM)

  credenciais CredencialSistema[]
  subdominio  Subdominio?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Um sistema só pode ter UMA infraestrutura por tipo de ambiente
  @@unique([sistemaId, ambiente, componente])
  @@index([servidorId])
  @@index([plataformaId])
}

model CredencialSistema {
  id                      Int                   @id @default(autoincrement())
  sistemaInfraestruturaId Int
  sistemaInfraestrutura   SistemaInfraestrutura @relation(fields: [sistemaInfraestruturaId], references: [id], onDelete: Cascade)

  tipo            TipoCredencial
  label           String
  valorEncriptado String         @db.Text // conteúdo encriptado (AES-256-GCM)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Atividade {
  id       String   @id @default(uuid())
  acao     String
  criadoEm DateTime @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  documentoId Int? // opcional — nem toda ação envolve um documento (ex: criação de utilizador)
  documento   Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  sistemaId Int?
  sistema   Sistema? @relation(fields: [sistemaId], references: [id], onDelete: SetNull)
}

enum EstadoDocumento {
  PENDENTE
  APROVADO
  REJEITADO
}

enum Perfil {
  ADMIN
  FUNCIONARIO
}

enum StatusSistema {
  EM_PRODUCAO        @map("Em Produção")
  EM_DESENVOLVIMENTO @map("Em Desenvolvimento")
  MANUTENCAO         @map("Manutenção")
}

enum TipoAmbiente {
  PRODUCAO
  TESTES
}

enum ComponenteSistema {
  FRONTEND
  BACKEND
}

enum TipoCredencial {
  ENV_VARIAVEIS
  CREDENCIAIS_BD
  CHAVE_TOKEN_API
  CHAVE_SSH
  CERTIFICADO_SSL
  CREDENCIAIS_DNS
  ACESSO_CONSOLA_CLOUD
  CREDENCIAIS_CICD
  CONFIGURACAO_VPN_FIREWALL
  CREDENCIAIS_SMTP
  BACKUP_ACESSO
  OUTRO
}

enum TipoPlataforma {
  CLOUD_BASE_DADOS
  CONTAINERIZACAO
  GESTAO_DOMINIO
}

enum TipoDns {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
  SRV
  CAA
  PTR
  SOA
  DS
  DNSKEY
  RRSIG
  TLSA
  SSHFP
  OUTRO
}

enum FornecedorPlataforma {
  // Containerização
  DOCKER_HUB
  GITHUB_CONTAINER_REGISTRY
  AWS_ECR
  GOOGLE_ARTIFACT_REGISTRY
  AZURE_CONTAINER_REGISTRY
  GITLAB_REGISTRY
  KUBERNETES
  DOCKER_SWARM
  PORTAINER

  // Cloud / Base de Dados
  AWS
  MICROSOFT_AZURE
  GOOGLE_CLOUD
  ORACLE_CLOUD
  DIGITALOCEAN
  HETZNER_CLOUD
  LINODE
  VULTR
  OVHCLOUD
  CONTABO
  VERCEL
  NETLIFY
  RAILWAY
  RENDER
  FLY_IO
  HEROKU
  SUPABASE
  PLANETSCALE
  MONGODB_ATLAS
  NEON
  AIVEN
  FIREBASE

  // Gestão de Domínio e DNS
  CLOUDFLARE
  GODADDY
  NAMECHEAP
  GANDI
  PORKBUN
  HOSTINGER
  SQUARESPACE_DOMAINS
  AWS_ROUTE_53
  AZURE_DNS
  GOOGLE_CLOUD_DNS
  CPANEL
  AGENTE_REGISTO_MZ

  // Qualquer tipo
  OUTRO
}

enum VisibilidadeImagem {
  PUBLICA
  PRIVADA
}

enum OrigemImagem {
  PROPRIA
  TERCEIROS
}

// RAM e disco
enum UnidadeArmazenamento {
  MB
  GB
  TB
}

// Largura de banda (velocidade da ligação, em bits por segundo)
enum UnidadeVelocidade {
  MBPS
  GBPS
}

enum EstadoServidor {
  ATIVO
  INATIVO
}